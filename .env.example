# =============================================================================
# Linguora — Environment Configuration Template
# Copy this file to .env.local for local development.
# =============================================================================

# Site URL (Base URL for absolute links, authentication redirects, and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Configuration
# Local development default values from `npx supabase status`
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# PostgreSQL Direct Connection String (Used for migrations, seed scripts, or direct db queries)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# AI Tutor Configuration (Anthropic Claude)
# Optional: Leave empty to disable AI tutor gracefully without runtime errors.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Supported models: claude-opus-5-5, claude-sonnet-4-5, claude-haiku-5-5
AI_TUTOR_MODEL=claude-opus-5-5
# Maximum AI tutor messages a student can send per day to control token costs
AI_TUTOR_DAILY_MESSAGE_LIMIT=30

# -----------------------------------------------------------------------------
# Background Jobs & Cron Security (Optional)
# Secret bearer token to secure cron endpoints (e.g. daily streak evaluation / leaderboard snapshot)
# -----------------------------------------------------------------------------
CRON_SECRET=
